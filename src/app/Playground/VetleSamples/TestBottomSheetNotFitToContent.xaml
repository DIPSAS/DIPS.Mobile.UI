<?xml version="1.0" encoding="utf-8"?>

<!--
    Regression sample for the Android non-Fit content-fill fix.

    In non-Fit positioning (Medium/Large) the sheet has a fixed height. The content here is a
    Grid with RowDefinitions="*,Auto": the star row must fill the available sheet height and the
    Auto button row must pin to the bottom — matching iOS. Before the fix, on Android the star row
    collapsed and the buttons floated up, leaving the sheet background visible below.
-->
<dui:BottomSheet xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 xmlns:dui="http://dips.com/mobile.ui"
                 x:Class="Playground.VetleSamples.TestBottomSheetNotFitToContent"
                 Positioning="Medium"
                 BackgroundColor="{dui:Colors color_surface_neutral}"
                 Title="Not fit to content">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="{dui:Colors color_surface_neutral}">

        <!-- Star row: scrollable content that should fill the sheet height -->
        <dui:ScrollView Grid.Row="0"
                        Padding="{dui:Thickness size_3}">
            <dui:VerticalStackLayout Spacing="{dui:Sizes size_2}">
                <dui:Label Text="The star (*) row fills the sheet height"
                           Style="{dui:Styles Label=UI400}" />
                <dui:Label Text="Only a few items here — the button row below must still stay pinned to the bottom of the sheet, with the sheet background filling the space in between."
                           Style="{dui:Styles Label=Body200}"
                           TextColor="{dui:Colors color_text_subtle}" />

                <dui:Label Text="Item 1" Style="{dui:Styles Label=UI300}" />
                <dui:Label Text="Item 2" Style="{dui:Styles Label=UI300}" />
                <dui:Label Text="Item 3" Style="{dui:Styles Label=UI300}" />
            </dui:VerticalStackLayout>
        </dui:ScrollView>

        <!-- Auto row: button bar pinned to the bottom -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="{dui:Sizes size_2}"
              BackgroundColor="{dui:Colors color_surface_neutral}"
              Padding="{dui:Thickness Left=size_3, Right=size_3, Top=size_2, Bottom=size_3}">
            <dui:Button Grid.Column="0"
                        Text="Secondary"
                        Style="{dui:Styles Button=DefaultLarge}" />
            <dui:Button Grid.Column="1"
                        Text="Primary"
                        Style="{dui:Styles Button=CallToActionLarge}" />
        </Grid>
    </Grid>

</dui:BottomSheet>